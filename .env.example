# Адрес и порт сайта. 0.0.0.0 — сайт открывается с телефонов и компьютеров
# в той же сети (http://IP-компьютера:8000); 127.0.0.1 — только на этом компьютере
HOST=0.0.0.0
PORT=8000
# Ключ подписи сессий. Если не задан, создаётся автоматически в data/secret_key
SECRET_KEY=
# 1 — если сайт открывают только по HTTPS (за nginx, Caddy и т.п.)
SECURE_COOKIES=
# Ссылка на Google Таблицу для экспорта и импорта (или её ID)
GOOGLE_TABLE=
